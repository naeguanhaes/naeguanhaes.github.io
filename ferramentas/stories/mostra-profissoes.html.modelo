<!doctype html><html lang=pt-BR><head><meta charset=utf-8><link rel=stylesheet href="/assets/min/estilo.min.css"><style>
html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:#15315A}
.st{position:relative;width:1080px;height:1920px;overflow:hidden;color:#fff;font-family:var(--sans);
 background:linear-gradient(165deg,#0E1F3A 0%,#15315A 55%,#1E4478 100%);display:flex;flex-direction:column;align-items:center;text-align:center;padding:210px 80px 0;box-sizing:border-box}
.b1{position:absolute;width:600px;height:600px;border-radius:46% 54% 60% 40%/50% 42% 58% 50%;background:#FFC93C;top:-320px;left:-240px}
.b2{position:absolute;width:560px;height:560px;border-radius:58% 42% 40% 60%/45% 55% 45% 55%;background:#FFC93C;bottom:-300px;right:-220px}
.faixa{position:relative;font-weight:800;letter-spacing:.18em;text-transform:uppercase;font-size:34px;color:#15315A;background:#FFC93C;padding:12px 34px;border-radius:99px}
h1{position:relative;font-family:var(--serif);font-weight:600;font-size:96px;line-height:1.04;margin:30px 0 34px}
.cartaz{position:relative;width:500px;border-radius:26px;box-shadow:0 30px 60px -20px rgba(0,0,0,.7)}
.dados{position:relative;margin-top:44px;display:flex;gap:18px}
.dados span{background:rgba(255,255,255,.12);border:2px solid rgba(255,255,255,.35);border-radius:22px;padding:14px 26px;font-size:34px}
.dados b{font-family:var(--serif);font-size:52px;margin-right:10px}
.rodape{position:relative;margin-top:auto;margin-bottom:230px;display:flex;flex-direction:column;align-items:center;gap:16px}
.link{font-size:34px;font-weight:700;background:#FFC93C;color:#15315A;border-radius:99px;padding:16px 34px}
.da{font-size:28px;color:#DCE6F7}
</style></head><body><div class=st><span class=b1></span><span class=b2></span>
<span class=faixa>Chamada de voluntários</span>
<h1>1ª Mostra de<br>Profissões UEMG</h1>
<img class=cartaz src="/assets/eventos/mostra-profissoes-2026.webp" alt="">
<div class=dados><span><b>13/11</b>sexta</span><span><b>13h</b>a partir das</span></div>
<div class=rodape><span class=link>naeguanhaes.github.io/mostra-profissoes.html</span><span class=da>Realização: Diretório Acadêmico Sapientia et Justitia</span></div>
</div></body></html>
